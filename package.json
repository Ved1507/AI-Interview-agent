{
    "name":  "technical-interview-agent",
    "version":  "1.0.0",
    "description":  "AI-powered technical interview agent with structured scoring and human review",
    "main":  "dist/src/index.js",
    "scripts":  {
                    "build":  "tsc",
                    "start":  "node dist/src/index.js",
                    "dev":  "ts-node src/index.ts",
                    "test":  "jest --coverage",
                    "test:unit":  "jest tests/unit --coverage",
                    "lint":  "eslint src --ext .ts",
                    "format":  "prettier --write \"src/**/*.ts\""
                },
    "keywords":  [
                     "interview",
                     "ai",
                     "recruiting",
                     "assessment",
                     "scoring",
                     "claude"
                 ],
    "author":  "Your Team",
    "license":  "MIT",
    "dependencies":  {
                         "ajv":  "^8.12.0",
                         "body-parser":  "^1.20.2",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.3.1",
                         "express":  "^4.18.2",
                         "mammoth":  "^1.6.0",
                         "multer":  "^1.4.5-lts.1",
                         "openai":  "^4.28.0",
                         "pdf-parse":  "^2.4.5",
                         "pdfkit":  "^0.13.0",
                         "typescript":  "^5.2.2",
                         "uuid":  "^9.0.0"
                     },
    "devDependencies":  {
                            "@types/express":  "^4.17.20",
                            "@types/jest":  "^29.5.5",
                            "@types/node":  "^20.7.2",
                            "@typescript-eslint/eslint-plugin":  "^6.7.0",
                            "@typescript-eslint/parser":  "^6.7.0",
                            "eslint":  "^8.50.0",
                            "jest":  "^29.7.0",
                            "prettier":  "^3.0.3",
                            "ts-jest":  "^29.1.1",
                            "ts-node":  "^10.9.1"
                        },
    "engines":  {
                    "node":  "\u003e=16.0.0",
                    "npm":  "\u003e=8.0.0"
                }
}
